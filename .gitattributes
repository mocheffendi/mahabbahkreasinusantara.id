# Normalisasi line ending agar konsisten di semua OS
* text=auto

*.sh      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
*.conf    text eol=lf
Dockerfile text eol=lf
*.ps1     text eol=crlf

# Gambar = binary (jangan diubah)
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.avif binary
*.ico  binary
